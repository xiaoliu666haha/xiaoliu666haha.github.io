---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import TOC from "@components/widget/TOC.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/scrollbar.css";
import "../styles/minimal.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}
const { headings = [], ...pageProps } = Astro.props;
---
<Layout {...pageProps}>
    <slot slot="head" name="head" />
    <div id="top-row" class="minimal-header">
        <div id="navbar-wrapper"><Navbar /></div>
    </div>
    <div id="main-grid" class="minimal-shell">
        <main id="swup-container" class="transition-swup-fade">
            <div id="content-wrapper"><slot /></div>
        </main>
        <Footer />
    </div>
    <div id="toc-wrapper" class="minimal-toc">
        <div id="toc">{siteConfig.toc.enable && <TOC headings={headings} />}</div>
    </div>
    <BackToTop />
</Layout>
