---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import type { Page } from "astro";

interface Props {
	page: Page<CollectionEntry<"posts">>;
}
const { page } = Astro.props;
---
<section aria-label="文章列表">
    <div class="journal-heading"><span>文章</span><span>{page.total} 篇</span></div>
    {page.data.length === 0 ? (
        <div class="journal-empty">
            <h2>这里即将开始记录。</h2>
            <p>还没有发布文章，写好后再见。</p>
        </div>
    ) : page.data.map((entry) => (
        <article class="journal-post">
            <time datetime={entry.data.published.toISOString()}>{entry.data.published.toISOString().slice(0, 10)}</time>
            <h2><a href={getPostUrlBySlug(entry.slug)}>{entry.data.title}</a></h2>
            {entry.data.description && <p>{entry.data.description}</p>}
        </article>
    ))}
</section>
